<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>View Card Details - Trading Card Collection Tracker</title>
    <meta name="description" content="Instructions for viewing card details">
    <meta name="author" content="Kevin Bennett">
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand" href="/">Trading Card Tracker</a>

        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" href="/">Home</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/documentation">Documentation</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/quickstart">Quickstart</a>
            </li>
        </ul>
    </nav>

    <main class="container mt-4 mb-5">
        <h1>View Card Details</h1>

        <ol>
            <li>Select a card from the table on the main window.</li>
            <li>Click <strong>View Details</strong>.</li>
            <li>
                Review the card's name, game, set, and card number in the
                details window.
            </li>
            <li>Click <strong>Back</strong> to return to the collection.</li>
        </ol>

        <img src="/images/card-details.png"
             class="img-fluid border"
             alt="Card Details window">
    </main>
</body>
</html>