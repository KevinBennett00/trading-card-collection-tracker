<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Add a Card - Trading Card Collection Tracker</title>
    <meta name="description" content="Instructions for adding a trading card">
    <meta name="author" content="Kevin Bennett">
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand" href="/">Trading Card Tracker</a>

        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" href="/">Home</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/documentation">Documentation</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/quickstart">Quickstart</a>
            </li>
        </ul>
    </nav>

    <main class="container mt-4 mb-5">
        <h1>Add a Card</h1>

        <ol>
            <li>Click <strong>Add Card</strong> on the main window.</li>
            <li>Enter the card's name.</li>
            <li>Enter the name of the game.</li>
            <li>Enter the card's set.</li>
            <li>Enter the card number.</li>
            <li>
                Click <strong>Save</strong> to add the card to the collection.
            </li>
            <li>
                Click <strong>Cancel</strong> to return without adding the
                card.
            </li>
        </ol>

        <p>
            Every field is required.

        <img src="/images/add-card.png"
             class="img-fluid border"
             alt="Add Card window">
    </main>
</body>
</html>